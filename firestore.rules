rules_version = '2';

/* ===== Reglas de seguridad de Firestore =====

   ESTO es lo que protege los datos. No el JavaScript de la página:
   cualquiera puede abrir las herramientas del navegador y cambiarlo.
   Estas reglas corren en los servidores de Google y no se pueden
   esquivar desde el navegador.

   Dónde pegarlas:
     console.firebase.google.com -> tu proyecto
     -> Firestore Database -> pestaña "Reglas"
     -> pega todo este archivo -> Publicar

   Qué dicen, en una línea: cada quien puede leer y escribir
   únicamente dentro de su propia carpeta, y nada más.            */

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {

      // Solo el dueno de la carpeta, y solo con la sesion iniciada.
      function esDueno() {
        return request.auth != null && request.auth.uid == uid;
      }

      function datos() {
        return request.resource.data;
      }

      // Cada tipo de movimiento exige sus propios campos.
      function formaCorrecta() {
        return datos().tipo == 'transferencia'
          // Mover dinero: de una cuenta a otra, y no a si misma.
          ? (datos().cuentaOrigen is string
             && datos().cuentaDestino is string
             && datos().cuentaOrigen != datos().cuentaDestino)
          // Entrada o salida: siempre se sabe en que cuenta cae.
          : (datos().cuenta is string
             && datos().cuenta.size() > 0
             // El motivo es obligatorio en las salidas de dinero.
             && (datos().tipo == 'ingreso'
                 || (datos().motivo is string && datos().motivo.size() > 0)));
      }

      /* --- Cuentas donde se guarda el dinero --- */
      match /cuentas/{cuenta} {
        allow read, delete: if esDueno();

        allow create, update: if esDueno()
          && datos().nombre is string
          && datos().nombre.size() > 0
          && datos().nombre.size() <= 40
          && datos().tipo in ['banco', 'efectivo', 'tarjeta']
          // El saldo inicial puede ser negativo (una tarjeta con deuda).
          && datos().saldoInicial is number;
      }

      /* --- Movimientos: entradas, salidas y transferencias --- */
      match /movimientos/{movimiento} {
        allow read, delete: if esDueno();

        // Al escribir se revisa que el dato tenga buena forma: asi un
        // error de la pagina no mete basura en la base.
        allow create, update: if esDueno()
          && datos().tipo in ['ingreso', 'gasto', 'transferencia']
          && datos().cantidad is number
          && datos().cantidad > 0
          && datos().fecha is string
          && datos().nombre is string
          && formaCorrecta();
      }
    }

    // Todo lo demás queda cerrado. Sin esta línea, una colección
    // nueva creada por descuido podría quedar abierta a cualquiera.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
